# Copy to .env.local for local development. On Vercel, set these as
# project environment variables. Never commit .env.local.

# --- Mode -------------------------------------------------------------------
# MOCK=1 serves realistic fake data from src/lib/intinor/mock/ — no request
# ever reaches the real unit. Recommended for all UI development, and for the
# initial Vercel deployment.
MOCK=1

# --- Unit connection (only needed when MOCK is off) -------------------------
# Host or IP of the unit; use iss.intinor.se to go through Intinor's central
# management instead of the unit's own address.
INTINOR_UNIT_HOST=
# Unit serial, e.g. D01393
INTINOR_UNIT_ID=D01393
# Unit API user. The password is only used server-side to mint a temporary
# session id (POST /users/{username}/sessions); neither ever reaches the browser.
INTINOR_USERNAME=
INTINOR_PASSWORD=

# MOCK_ROLE simulates the logged-in user's field-level permissions in mock
# mode, so the settings UI's read-only handling can be exercised without a
# real restricted account on the unit:
#   admin    (default) everything editable  (_constraints.mutable = ["*"])
#   operator a realistic partial grant      (only some fields editable)
#   viewer   nothing editable               (mutable = [])
#   unknown  omits `mutable` entirely       (fail-safe: treated as read-only)
#MOCK_ROLE=operator

# --- Safety switches (default off — leave them off) -------------------------
# INTINOR_ALLOW_WRITES=1 lets PUT/POST/DELETE through the proxy to the live
# unit. Keep unset until a specific write feature has been reviewed/approved.
# Destructive endpoints (reboot, format, firmware…) stay blocked regardless.
#INTINOR_ALLOW_WRITES=

# INTINOR_ALLOW_SELF_SIGNED=1 accepts the unit's self-signed TLS certificate
# when connecting by IP on the LAN.
#INTINOR_ALLOW_SELF_SIGNED=
