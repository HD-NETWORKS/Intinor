# Copy to .env.local for local development. On Vercel, set these as
# project environment variables. Never commit .env.local.

# --- Mode -------------------------------------------------------------------
# MOCK=1 serves realistic fake data from src/lib/intinor/mock/ — no request
# ever reaches the real unit. Recommended for all UI development, and for the
# initial Vercel deployment.
MOCK=1

# --- Unit connection (only needed when MOCK is off) -------------------------
# The "primary" unit — reached at /api/unit and by default from every route.
# Host or IP of the unit; use iss.intinor.se to go through Intinor's central
# management instead of the unit's own address.
INTINOR_UNIT_HOST=
# Unit serial, e.g. D01393
INTINOR_UNIT_ID=D01393
# Unit API user. The password is only used server-side to mint a temporary
# session id (POST /users/{username}/sessions); neither ever reaches the browser.
INTINOR_USERNAME=
INTINOR_PASSWORD=

# Additional units, as a JSON array — each becomes reachable at
# /api/units/{id}/... immediately, no code change. Typically these share the
# primary unit's host (iss.intinor.se) and differ only by id/credentials:
#INTINOR_UNITS=[{"id":"D02237","host":"iss.intinor.se","username":"...","password":"..."}]

# MOCK_ROLE simulates the logged-in user's field-level permissions in mock
# mode, so the settings UI's read-only handling can be exercised without a
# real restricted account on the unit:
#   admin    (default) everything editable  (_constraints.mutable = ["*"])
#   operator a realistic partial grant      (only some fields editable)
#   viewer   nothing editable               (mutable = [])
#   unknown  omits `mutable` entirely       (fail-safe: treated as read-only)
#MOCK_ROLE=operator

# MOCK_FAULT injects fault conditions in mock mode so the Phase 4 alert rules,
# notification channels and anti-spam behaviour can be verified end to end
# before anyone relies on them. Comma-separated:
#   stream_down | firmware | storage_full | link_loss
#MOCK_FAULT=stream_down

# --- Phase 4: monitoring, alerting & history --------------------------------
# Shared secret for /api/cron/poll. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`; other schedulers can pass ?secret=.
# Without it the endpoint refuses to run rather than sitting open.
CRON_SECRET=

# Supabase (free tier) for time-series history. Optional — without these the
# dashboard still shows live status, it just can't look backwards.
# Run supabase/schema.sql once, then paste the project URL + SERVICE ROLE key
# (server-side only; it bypasses RLS and must never reach the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alert channels — all optional, each inactive until configured.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#SLACK_WEBHOOK_URL=
#RESEND_API_KEY=
#ALERT_EMAIL_TO=
#ALERT_EMAIL_FROM=
# Generic JSON webhook — also what the local test harness points at.
#ALERT_WEBHOOK_URL=
# Resolve channels but log instead of sending:
#ALERTS_DRY_RUN=1

# --- Safety switches (default off — leave them off) -------------------------
# INTINOR_ALLOW_WRITES=1 lets PUT/POST/DELETE through the generic proxy to the
# live unit. Keep unset until a specific write feature has been reviewed.
# system/actions/* (reboot, shutdown, firmware…) stay blocked at the generic
# proxy regardless of this flag — see INTINOR_ALLOW_DESTRUCTIVE_ACTIONS below.
#INTINOR_ALLOW_WRITES=

# INTINOR_ALLOW_DESTRUCTIVE_ACTIONS=1 is the separate, higher-stakes switch for
# the dashboard's "Danger zone" (/system): reboot, power cycle, shutdown,
# restart streams, firmware upgrade. Off by default and independent of
# INTINOR_ALLOW_WRITES — turning on routine settings writes must never quietly
# turn this on too. Even when set, each action still requires typing its own
# name to confirm in the UI (see src/lib/intinor/server/system-actions.ts).
#INTINOR_ALLOW_DESTRUCTIVE_ACTIONS=

# INTINOR_ALLOW_SELF_SIGNED=1 accepts the unit's self-signed TLS certificate
# when connecting by IP on the LAN.
#INTINOR_ALLOW_SELF_SIGNED=

# --- Phase 5: dashboard login gate -------------------------------------------
# The dashboard's own login — separate from the unit's credentials above,
# which are used server-side only and were never a login for this app. Set all
# three before deploying anywhere reachable from the internet; the proxy
# (src/proxy.ts) refuses every request rather than sitting open if they're
# missing.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Random signing key for the session cookie, e.g. `openssl rand -base64 32`.
AUTH_SECRET=
# How long a login lasts before needing to sign in again. Default 12.
#DASHBOARD_SESSION_HOURS=12

# Explicit, documented escape hatch for local-only development — never set
# this on anything reachable from the internet (Vercel included).
#DASHBOARD_AUTH_DISABLED=1
