{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Same project name shown in the Cloudflare dashboard; distinct from the
  // "intinor-cron-poll" Worker in cron-worker/ — separate deployables.
  "name": "intinor",
  "main": ".open-next/worker.js",
  // Must be 2024-09-23 or later for @opennextjs/cloudflare's Node.js
  // compat requirements (session signing uses node:crypto, etc).
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Empty on purpose: every env var this app needs (DASHBOARD_USERNAME,
  // AUTH_SECRET, INTINOR_*, SUPABASE_*, etc.) is set as an encrypted Secret
  // on the Cloudflare dashboard, not a plain var — nothing here to declare.
  "vars": {},
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
